{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"color": "#ffffff",
					"name": "Base",
					"slug": "custom-base"
				},
				{
					"color": "#444444",
					"name": "Contrast",
					"slug": "custom-contrast"
				},
				{
					"color": "#003c71",
					"name": "Primary",
					"slug": "custom-primary"
				},
				{
					"color": "#71003c",
					"name": "Accent",
					"slug": "custom-accent"
				},
				{
					"color": "#0057a4",
					"name": "Hover",
					"slug": "custom-hover"
				}
			]
		},
		"layout": {
			"contentSize": "50rem",
			"wideSize": "62.5rem"
		},
		"spacing": {
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "\"Noto Sans\"",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/noto-sans/noto-sans-700-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Noto Sans\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/noto-sans/noto-sans-400-normal.woff2"
							]
						}
					],
					"fontFamily": "\"Noto Sans\", sans-serif",
					"name": "Noto Sans",
					"slug": "noto-sans"
				},
				{
					"fontFace": [
						{
							"fontFamily": "\"Noto Serif\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/noto-serif/noto-serif-400-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Noto Serif\"",
							"fontStyle": "Italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/noto-serif/noto-serif-400-italic.woff2"
							]
						}
					],
					"fontFamily": "\"Noto Serif\", serif",
					"name": "Noto Serif",
					"slug": "noto-serif"
				}
			],
			"fontSizes": [
				{
					"fluid": {
						"max": "1.13rem",
						"min": "1rem"
					},
					"name": "Small",
					"size": "1rem",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "1.25rem",
						"min": "1.19rem"
					},
					"name": "Medium",
					"size": "1.13rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "1.75rem",
						"min": "1.25rem"
					},
					"name": "Large",
					"size": "1.5rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "2.25rem",
						"min": "1.75rem"
					},
					"name": "Extra Large",
					"size": "2rem",
					"slug": "x-large"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/button": {
				"border": {
					"radius": {
						"bottomLeft": "9999px",
						"bottomRight": "9999px",
						"topLeft": "9999px",
						"topRight": "9999px"
					}
				},
				"spacing": {
					"padding": {
						"bottom": "24px",
						"left": "48px",
						"right": "48px",
						"top": "24px"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--noto-sans)",
					"fontStyle": "normal",
					"fontWeight": "700",
					"textTransform": "uppercase"
				}
			},
			"core/heading": {
				"color": {
					"text": "var(--wp--preset--color--custom-contrast)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--custom-contrast)"
						}
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--noto-sans)"
				}
			}
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--custom-accent)",
					"text": "var(--wp--preset--color--custom-base)"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--custom-contrast)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--custom-contrast)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--custom-primary)"
				}
			}
		},
		"spacing": {
			"padding": {
				"bottom": "0px",
				"left": "1rem",
				"right": "1rem",
				"top": "0px"
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}